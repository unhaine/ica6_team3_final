generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                @id @default(cuid())
  name              String?
  username          String?               @unique
  email             String?
  emailVerified     DateTime?
  image             String?
  password          String?
  householdSize     Int?
  allergies         String[]              @default([])
  cookingPreference String?
  surveyCompleted   Boolean               @default(false)
  surveyCompletedAt DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  accounts          Account[]
  favoriteRecipes   FavoriteRecipe[]
  fridgeAnalyses    FridgePhotoAnalysis[]
  groceryItems      GroceryItem[]
  receiptScans      ReceiptScan[]
  sessions          Session[]
  posts             CommunityPost[]
  following         Follow[]              @relation("follower")
  followedBy        Follow[]              @relation("following")
  comments          PostComment[]
  likes             PostLike[]

  @@index([username])
  @@index([email])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GroceryItem {
  id          String   @id @default(cuid())
  userId      String   // 소유자
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String   // 식료품 이름
  quantity    String?  // 수량 (예: "1개", "700g")
  category    String?  // 카테고리 (채소, 과일, 육류 등)
  price       Int?     // 가격
  source      String?  // 출처 (receipt-ocr, fridge-photo, manual)
  expiryDate  DateTime? // 유통기한
  purchaseDate DateTime? // 구매일
  
  // 메타데이터
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 영수증 스캔과의 관계
  receiptId   String?
  receipt     ReceiptScan? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  // 식재료 마스터 참조
  ingredientId Int?       @map("ingredient_ref_id")
  ingredient   IngredientRef? @relation(fields: [ingredientId], references: [id])
  
  @@index([userId])
  @@index([name])
  @@index([category])
  @@index([expiryDate])
  @@index([createdAt])
}

model ReceiptScan {
  id           String        @id @default(cuid())
  userId       String
  imageUrl     String?
  storeName    String?
  totalAmount  Int?
  scanDate     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  groceryItems GroceryItem[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scanDate])
}

model FridgePhotoAnalysis {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String?
  apiSource    String
  itemCount    Int
  analysisData Json
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([apiSource])
}

model Recipe {
  rcpSno        BigInt             @id @map("rcp_sno")
  rcpTtl        String?            @map("rcp_ttl") @db.VarChar(200)
  ckgNm         String?            @map("ckg_nm") @db.VarChar(40)
  rgtrId        String?            @map("rgtr_id") @db.VarChar(32)
  rgtrNm        String?            @map("rgtr_nm") @db.VarChar(64)
  inqCnt        Int?               @default(0) @map("inq_cnt")
  rcmmCnt       Int?               @default(0) @map("rcmm_cnt")
  srapCnt       Int?               @default(0) @map("srap_cnt")
  ckgMthActoNm  String?            @map("ckg_mth_acto_nm") @db.VarChar(200)
  ckgStaActoNm  String?            @map("ckg_sta_acto_nm") @db.VarChar(200)
  ckgMtrlActoNm String?            @map("ckg_mtrl_acto_nm") @db.VarChar(200)
  ckgKndActoNm  String?            @map("ckg_knd_acto_nm") @db.VarChar(200)
  ckgIpdc       String?            @map("ckg_ipdc") @db.VarChar(4000)
  ckgMtrlCn     String?            @map("ckg_mtrl_cn") @db.VarChar(4000)
  ckgInbunNm    String?            @map("ckg_inbun_nm") @db.VarChar(200)
  ckgDodfNm     String?            @map("ckg_dodf_nm") @db.VarChar(200)
  ckgTimeNm     String?            @map("ckg_time_nm") @db.VarChar(200)
  firstRegDt    String?            @map("first_reg_dt") @db.Char(14)
  rcpImgUrl     String?            @map("rcp_img_url") @db.VarChar(500)
  step_id       Int?
  step_desc     String?            @db.VarChar(512)
  favorites     FavoriteRecipe[]
  ingredients   RecipeIngredient[]
  steps         RecipeStep[]
  posts         CommunityPost[]

  @@index([ckgNm])
  @@index([ckgMtrlActoNm])
  @@index([ckgKndActoNm])
  @@map("Recipe")
}

// --------------------------------
// 식재료 마스터 (정규화)
// --------------------------------
model IngredientRef {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String?
  image     String?  @map("ingre_file") 
  
  // Relations
  recipeIngredients RecipeIngredient[]
  groceryItems      GroceryItem[]
  
  @@map("ingredient_refs")
}

// 레시피 식재료
model RecipeIngredient {
  rcpSno    BigInt  @map("rcp_sno")
  ingId     Int     @map("ing_id")
  ingName   String  @map("ing_name")
  ingUnit   String? @map("ing_unit")

  // 식재료 마스터 참조 (Optional for migration)
  ingredientId Int?       @map("ingredient_ref_id")
  ingredient   IngredientRef? @relation(fields: [ingredientId], references: [id])

  recipe    Recipe  @relation(fields: [rcpSno], references: [rcpSno], onDelete: Cascade)

  @@id([rcpSno, ingId])
  @@map("RecipeIngredient")
}

model RecipeStep {
  rcpSno   BigInt @map("rcp_sno")
  stepId   Int    @map("step_id")
  stepDesc String @map("step_desc")
  recipe   Recipe @relation(fields: [rcpSno], references: [rcpSno], onDelete: Cascade)

  @@id([rcpSno, stepId])
  @@map("RecipeStep")
}

model FavoriteRecipe {
  id        String   @id @default(cuid())
  userId    String
  recipeId  BigInt
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [rcpSno], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

model CommunityPost {
  id        String        @id @default(cuid())
  userId    String
  recipeId  BigInt?       @map("recipe_id")
  title     String        @db.VarChar(255)
  imageUrl  String?
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  recipe    Recipe?       @relation(fields: [recipeId], references: [rcpSno])
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  PostComment[]
  likes     PostLike[]

  @@index([userId])
  @@index([recipeId])
  @@index([createdAt])
  @@map("community_posts")
}

model PostLike {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("post_likes")
}

model PostComment {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  content   String        @db.VarChar(500)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@index([createdAt])
  @@map("post_comments")
}
