# RefrigerAI - Production Environment Variables
# Copy this file to .env.production and fill in your values

# ===== Database =====
POSTGRES_USER=refrigerai
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=refrigerai

# DATABASE_URL will be auto-generated in docker-compose
# Format: postgresql://user:password@db:5432/database?schema=public

# ===== AI API Keys =====
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ===== Next.js =====
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ===== Optional: External Access =====
# If you want to connect to DB from outside Docker
# DATABASE_URL=postgresql://user:password@your-ec2-ip:5432/database?schema=public
